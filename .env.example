# scripts/deploy.sh creates .env with generated values; this file is for manual setup.
# JWT signing key
SECRET_KEY=change-me-to-a-secure-random-string

# AES encryption key for SSH credentials (MUST be exactly 32 characters)
SSH_CREDENTIAL_KEY=change-me-exactly-32-chars-long!

# Public browser URL used by approval buttons in administrator emails
# Example: https://serverdock.example.com or https://192.0.2.10
PUBLIC_URL=

# TLS certificate chain and private key on the Docker host
TLS_CERT_PATH=./certs/serverdock.crt
TLS_KEY_PATH=./certs/serverdock.key

# Default admin account (only used on first startup)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# Debug mode
DEBUG=false

# Host HTTPS port
HTTPS_PORT=443

# HTTPS port used by the Vite development server
DEV_HTTPS_PORT=3000

# Optional: token for a remotely managed Cloudflare Tunnel
# Configure its public hostname to use http://frontend:80 as the service URL.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TUNNEL_URL=http://frontend:80
