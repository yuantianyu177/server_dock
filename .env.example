# JWT signing key (change this to a random string)
SECRET_KEY=change-me-to-a-secure-random-string

# AES encryption key for SSH credentials (MUST be exactly 32 characters)
SSH_CREDENTIAL_KEY=change-me-exactly-32-chars-long!

# Default admin account (only used on first startup)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# Debug mode
DEBUG=false

# Host port mapping
PORT=8080
